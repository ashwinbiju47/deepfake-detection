# ---------------------------------------------------------------------------
# Deepfake Detection Platform - backend environment variables
# Copy to `.env` and adjust. All values have sensible development defaults.
# ---------------------------------------------------------------------------

# Core Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=deepfake
POSTGRES_USER=deepfake
POSTGRES_PASSWORD=deepfake
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis (shared broker + channel layer)
REDIS_URL=redis://localhost:6379/0
# Optional dedicated channel-layer Redis (defaults to REDIS_URL)
# CHANNEL_LAYER_REDIS_URL=redis://localhost:6379/1

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Worker capacity, clamped to 1-64 (Requirement 6.4)
CELERY_WORKER_CONCURRENCY=4
CELERY_TASK_MAX_RETRIES=3

# Transient media store (purged after analysis, Requirement 9)
# MEDIA_ROOT=/abs/path/to/transient_media
MEDIA_PURGE_DEADLINE_SECONDS=60

# Feature flags
EXTERNAL_URL_ENABLED=false
HEATMAP_ENABLED=false
REPORT_ENABLED=false

# Domain configuration
SUPPORTED_VIDEO_FORMATS=mp4,avi
MAX_UPLOAD_SIZE_BYTES=52428800
DECISION_THRESHOLD=0.5
FUSION_WEIGHT_VISUAL=0.6
FUSION_WEIGHT_AUDIO=0.4
URL_FETCH_TIMEOUT_SECONDS=30
